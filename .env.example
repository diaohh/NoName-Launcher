# Copy to .env and fill in. Never commit .env.

# Everything here is read at BUILD time (pnpm dev / pnpm build). The packaged launcher never
# reads .env; a variable set in the environment overrides this file.

# --- Microsoft authentication (inlined into the main process) ---
# Required: the build stops if it is missing or is not an Azure application id.
# Azure app registration: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Must be a public client with redirect URI
# https://login.microsoftonline.com/common/oauth2/nativeclient
# and the "XboxLive.signin offline_access" scopes.
MICROSOFT_CLIENT_ID=your-azure-client-id

# --- Firebase (renderer) ---
# The VITE_ prefix is required: electron-vite only exposes prefixed variables to the
# renderer. Without these the modpack list cannot load.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
