// Renderer and src/shared. No node types: the renderer is sandboxed and has no `process`,
// `Buffer` or `fs`, and the checker should say so. `pnpm typecheck:web` passes --noEmit.
{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Incremental migration: JavaScript is compiled alongside but not checked, and every
    // .ts/.tsx file is strict from the day it is written.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"]
}
