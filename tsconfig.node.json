// Main process, preload and src/shared. electron-vite compiles; tsc only checks
// (`pnpm typecheck:node` passes --noEmit and drops `composite`, which only the editor needs).
{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Every source is TypeScript (ADR-0015), and strict.
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
